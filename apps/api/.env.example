PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://sproutly:sproutly@localhost:5432/sproutly
REDIS_URL=redis://localhost:6379

# 32+ random characters each, e.g. `openssl rand -base64 48`
JWT_SECRET=
OTP_SECRET=

# Optional: Google sign-in is hidden/disabled until set (also set VITE_GOOGLE_CLIENT_ID in apps/web/.env)
GOOGLE_CLIENT_ID=

# Optional: without it, sign-in codes are printed to this console
EMAIL_API_KEY=
EMAIL_FROM=Sproutly <hello@sproutly.app>

# Later slices
VAPID_PRIVATE_KEY=
GEOCODING_API_KEY=
